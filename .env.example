# MVidarr Environment Configuration
# Copy this file to .env and fill in your values

# ========================================
# REQUIRED: Database Configuration
# ========================================
DB_USER=mvidarr
DB_PASSWORD=your_secure_database_password_here
DB_NAME=mvidarr
MYSQL_ROOT_PASSWORD=your_secure_root_password_here

# ========================================
# REQUIRED: Application Security
# ========================================
# Generate a random 32+ character string
# Example: openssl rand -hex 32
SECRET_KEY=your_secret_key_here_minimum_32_characters

# ========================================
# REQUIRED: Music Videos Path
# ========================================
# Absolute path to your music video collection
MUSIC_VIDEOS_PATH=/path/to/your/music/videos

# ========================================
# OPTIONAL: Port Configuration
# ========================================
MVIDARR_PORT=5000

# ========================================
# OPTIONAL: Data Paths
# ========================================
# Leave as defaults or specify custom paths
DOWNLOADS_PATH=./data/downloads
THUMBNAILS_PATH=./data/thumbnails
DATABASE_PATH=./data/database
LOGS_PATH=./data/logs
CACHE_PATH=./data/cache

# ========================================
# OPTIONAL: API Keys (for metadata enrichment)
# ========================================
# IMVDb API Key - Get from https://imvdb.com/developers
IMVDB_API_KEY=

# YouTube API Key - Get from Google Cloud Console
YOUTUBE_API_KEY=

# ========================================
# OPTIONAL: Timezone
# ========================================
TZ=America/New_York

# ========================================
# OPTIONAL: User/Group IDs (for file permissions)
# ========================================
# Run 'id' command to get your user/group IDs
PUID=1000
PGID=1000

# ========================================
# OPTIONAL: CORS / Reverse Proxy Security
# ========================================
# Comma-separated list of origins allowed to make cross-origin requests.
# Defaults to localhost/127.0.0.1 on this project's known ports (5000, 5001,
# 5050) plus https://mvidarr.prefect42.com. Override if your deployment uses
# a different host or port.
# Example: CORS_ALLOWED_ORIGINS=https://videos.example.com,http://192.168.1.50:5000
CORS_ALLOWED_ORIGINS=

# Comma-separated list of proxy hosts/IPs trusted to set X-Forwarded-* headers.
# Defaults to loopback only (127.0.0.1). If MVidarr sits behind a reverse
# proxy (nginx, Traefik, Cloudflare Tunnel, etc.), set this to the proxy's
# IP/hostname — otherwise HTTPS detection behind the proxy will misbehave and
# you'll see the browser block requests as "mixed active content" (page loads
# over https://, but API calls redirect to a bare http:// URL).
#
# GOTCHA: if the proxy runs on the SAME Docker host as MVidarr but reaches it
# via the published port (e.g. proxy -> http://<host-ip>:5050) rather than a
# shared Docker network, Docker's hairpin NAT rewrites the connection's source
# address to the *bridge gateway* IP (typically 172.x.x.1) before it ever
# reaches the container — not the proxy container's own IP. Setting this to
# the proxy's container IP will silently never match in that setup. Find the
# real value with:
#   docker exec <container> sh -c "grep ' 01 ' /proc/net/tcp | grep ':1388 '"
# (1388 hex = port 5000) while making a request through the proxy, then
# decode the remote address column (reversed hex octets) to a dotted IP. If
# the proxy instead joins MVidarr's Docker network directly, its own
# container IP is preserved and trusted normally — a tighter boundary than
# the shared gateway, since the gateway also trusts anything else local to
# that host that reaches the published port.
# Leaving this at "*" (trust any peer) is NOT recommended: it lets a client
# that can reach MVidarr directly spoof its IP, bypassing rate limiting and
# forging the source IP in login/2FA audit logs.
TRUSTED_PROXY_HOSTS=
