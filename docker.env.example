# MVidarr Docker Environment Configuration
# Copy this file to docker.env and modify as needed

# NOTE: Scheduler V2 configuration is now managed through the database
# via the Settings page in the web UI. Environment variables for scheduling
# are no longer used. See docs/CONFIGURATION_GUIDE.md for details.

# Database Configuration
DATABASE_URL=sqlite:///data/mvidarr.db

# Security Configuration
MVIDARR_SECRET_KEY=your-very-secure-secret-key-here

# Application Configuration
FLASK_ENV=production
PORT=5000

# Authentication (for simple auth mode)
REQUIRE_AUTHENTICATION=false