# Multi-stage build for MVidarr production deployment
# Fixed build timeout issues and optimized for reliability
# v1.0.0: Dynamic version.json generation at build time (Issue #161)

#################################
# Stage 1: Build Environment
#################################
FROM python:3.12-slim AS builder

# Build arguments for version information (passed from CI/CD)
ARG GIT_COMMIT=unknown
ARG GIT_BRANCH=unknown
ARG BUILD_DATE
ARG VERSION

# Install build dependencies in optimal order (avoid full build-essential)
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    pkg-config \
    default-libmysqlclient-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Upgrade pip separately for better caching
RUN pip install --no-cache-dir --upgrade pip

# Copy requirements and install with increased timeout
COPY requirements.txt requirements-fastapi.txt ./
RUN pip install --no-cache-dir --prefix=/opt/python --timeout=1000 -r requirements.txt && \
    pip install --no-cache-dir --prefix=/opt/python --timeout=1000 -r requirements-fastapi.txt

#################################
# Stage 2: Runtime Environment
#################################
FROM python:3.12-slim AS runtime

# Re-declare build arguments for runtime stage
ARG GIT_COMMIT=unknown
ARG GIT_BRANCH=unknown
ARG BUILD_DATE
ARG VERSION

# Convert build args to environment variables for version generation
ENV GIT_COMMIT=${GIT_COMMIT} \
    GIT_BRANCH=${GIT_BRANCH} \
    BUILD_DATE=${BUILD_DATE} \
    VERSION=${VERSION}

# Install runtime system dependencies including supervisord (cached layer - rarely changes)
# xz-utils is REQUIRED for extracting Node.js .tar.xz files
RUN apt-get update && apt-get install -y \
    xz-utils \
    curl \
    ffmpeg \
    wget \
    ca-certificates \
    default-libmysqlclient-dev \
    mariadb-client \
    netcat-openbsd \
    supervisor \
    procps \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get autoremove -y \
    && apt-get autoclean

# Install Node.js from official binaries (required for yt-dlp JavaScript runtime)
# This is CRITICAL for YouTube downloads to work properly in 2025
RUN curl -fsSL https://nodejs.org/dist/v20.18.1/node-v20.18.1-linux-x64.tar.xz -o /tmp/node.tar.xz \
    && tar -xJf /tmp/node.tar.xz -C /usr/local --strip-components=1 \
    && rm /tmp/node.tar.xz \
    && node --version && npm --version

# Create non-root user (cached layer - never changes)
RUN groupadd -r mvidarr && useradd -r -g mvidarr -u 1000 mvidarr

# Set working directory
WORKDIR /app

# Copy Python packages from builder stage (cached if requirements unchanged)
COPY --from=builder /opt/python /usr/local

# Create directories and set base permissions (cached layer - rarely changes)
RUN mkdir -p /app/data/downloads /app/data/musicvideos /app/data/music_videos /app/data/thumbnails /app/data/logs /app/data/cache /app/data/backups /app/data/database /app/data/cookies /app/config && \
    chown -R mvidarr:mvidarr /app/data /app/config

# Copy static configuration files first (cached if config unchanged)
COPY entrypoint.sh /app/entrypoint.sh
COPY supervisord.conf /etc/supervisor/conf.d/supervisord.conf

# Set up static files permissions (cached if static files unchanged)
RUN chmod +x /app/entrypoint.sh && chown root:root /app/entrypoint.sh && \
    touch /app/.env && chown mvidarr:mvidarr /app/.env && chmod 664 /app/.env

# Set environment variables (cached layer - rarely changes)
ENV PYTHONPATH=/app/src \
    PYTHONUNBUFFERED=1 \
    FLASK_ENV=production \
    PORT=5000 \
    HOST=0.0.0.0

# Copy application source code LAST (invalidates cache most frequently)
COPY --chown=mvidarr:mvidarr src/ /app/src/
COPY --chown=mvidarr:mvidarr frontend/ /app/frontend/
COPY --chown=mvidarr:mvidarr migrations/ /app/migrations/
COPY --chown=mvidarr:mvidarr scripts/ /app/scripts/
COPY --chown=mvidarr:mvidarr fastapi_app.py /app/

# Generate version.json at build time with correct git information
RUN python3 /app/scripts/generate_version.py --output /app/version.json && \
    chown mvidarr:mvidarr /app/version.json && \
    chmod 644 /app/version.json

# Set proper permissions for all application files
RUN find /app -type d -exec chmod 755 {} \; && \
    find /app -type f -exec chmod 644 {} \; && \
    chmod 755 /app/fastapi_app.py

# Expose the application port
EXPOSE 5000

# Use entrypoint script for initialization and startup
ENTRYPOINT ["/app/entrypoint.sh"]