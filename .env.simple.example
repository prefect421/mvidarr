# ===================================================================
# MVidarr Simple Production Configuration
# ===================================================================
# Copy this file to .env and configure for your setup
#   cp .env.simple.example .env
#   nano .env  # Edit the values below
# ===================================================================

# ===================================================================
# REQUIRED: Application Settings
# ===================================================================

# Port where MVidarr web interface will be accessible
MVIDARR_PORT=5000

# Timezone (see: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones)
TZ=America/New_York


# ===================================================================
# REQUIRED: Security Settings
# ===================================================================
# IMPORTANT: Change these to secure random values!
# Generate secure passwords: openssl rand -base64 32

# Database password for the mvidarr user
DB_PASSWORD=CHANGE_THIS_secure_db_password_here

# MariaDB root password
MYSQL_ROOT_PASSWORD=CHANGE_THIS_secure_root_password_here

# Redis password for caching and background jobs
REDIS_PASSWORD=CHANGE_THIS_secure_redis_password_here

# Application secret key (minimum 32 characters)
SECRET_KEY=CHANGE_THIS_very_long_random_secret_key_minimum_32_characters


# ===================================================================
# REQUIRED: Storage Paths
# ===================================================================
# Where your music videos are stored (this is the folder MVidarr will scan)
MUSIC_VIDEOS_PATH=/path/to/your/musicvideos

# Where MVidarr stores its data (thumbnails, database, logs, etc.)
# This will create subdirectories: thumbnails/, database/, logs/, downloads/, cache/, backups/
DATA_PATH=./data


# ===================================================================
# OPTIONAL: API Keys
# ===================================================================
# Get your IMVDB API key from: https://imvdb.com/developers
IMVDB_API_KEY=

# YouTube Data API key (for metadata enrichment)
# Get from: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=


# ===================================================================
# OPTIONAL: MeTube Integration
# ===================================================================
# MeTube is a yt-dlp Web UI for downloading music videos
# Enable it by running: docker-compose --profile metube up -d

METUBE_PORT=8081
METUBE_URL=http://metube:8081


# ===================================================================
# Configuration Complete!
# ===================================================================
# After configuring this file:
#
# 1. Start MVidarr:
#    docker-compose -f docker-compose.simple.yml up -d
#
# 2. Check status:
#    docker-compose -f docker-compose.simple.yml ps
#
# 3. View logs:
#    docker-compose -f docker-compose.simple.yml logs -f
#
# 4. Access MVidarr:
#    http://localhost:5000 (or your configured MVIDARR_PORT)
#
# 5. Health check:
#    http://localhost:5000/api/health/dashboard
# ===================================================================
