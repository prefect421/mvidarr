[Unit]
Description=MVidarr Celery Worker - Background Job Processing
Documentation=file:///home/mike/mvidarr/CELERY_BACKGROUND_JOBS_IMPLEMENTATION.md
After=network.target redis.service mvidarr.service
Wants=network-online.target
Requires=redis.service

[Service]
Type=exec
User=mike
Group=mike
WorkingDirectory=/home/mike/mvidarr

# Start Celery worker
ExecStart=/home/mike/mvidarr/venv/bin/celery -A src.jobs.celery_app worker --loglevel=info --concurrency=3 --hostname=worker@%%h

# Enhanced restart and failure handling
Restart=always
RestartSec=10
StartLimitInterval=600
StartLimitBurst=3
TimeoutStartSec=60
TimeoutStopSec=30
KillMode=mixed
KillSignal=SIGTERM

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mvidarr-celery-worker

# Environment variables
Environment=PATH=/home/mike/mvidarr/venv/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONPATH=/home/mike/mvidarr
Environment=PYTHONUNBUFFERED=1
Environment=REDIS_URL=redis://localhost:6379/0
Environment=CELERY_BROKER_URL=redis://localhost:6379/0
Environment=CELERY_RESULT_BACKEND=redis://localhost:6379/0
Environment=C_FORCE_ROOT=1

# Security settings
NoNewPrivileges=yes
PrivateTmp=yes

# Resource limits for background processing
LimitNOFILE=65536
LimitNPROC=4096

[Install]
WantedBy=multi-user.target