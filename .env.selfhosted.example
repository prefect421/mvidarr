# MVidarr Self-Hosted Production Configuration
# Copy this file to .env and customize for your setup

# Database Configuration
MYSQL_ROOT_PASSWORD=secure_root_password_change_me
MYSQL_PASSWORD=secure_mvidarr_password_change_me

# Redis Configuration
REDIS_PASSWORD=secure_redis_password_change_me

# Backup Configuration
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM
BACKUP_RETENTION_DAYS=7

# Monitoring & Alerts (Optional)
ALERT_EMAIL=your-email@example.com
DISCORD_WEBHOOK=https://discord.com/api/webhooks/your/webhook/url

# SMTP Settings (for email alerts)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Application Settings
LOG_LEVEL=INFO
WORKERS=4
MONITORING_ENABLED=true
BACKUP_ENABLED=true

# Domain/SSL Settings (if using proxy)
DOMAIN=mvidarr.yourdomain.com
SSL_EMAIL=your-email@example.com

# Update Settings
AUTO_UPDATE_ENABLED=false  # Set to true to enable automatic updates